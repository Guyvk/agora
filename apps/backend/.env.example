ADMIN_GOOGLE_CLIENT_ID=xxx
ADMIN_GOOGLE_CLIENT_SECRET=xxx
ANDROID_APP_STORE_URL=https://play.google.com/store/apps/details?id=com.hylo.hyloandroid
APP_BASE=apps/backend
AWS_REGION=us-east-1
AWS_S3_CONTENT_URL=https://hylo-staging.s3.amazonaws.com
AWS_S3_BUCKET=hylo-staging
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COOKIE_NAME=hylo-dev-local
COOKIE_SECRET=loremipsum
DATABASE_URL=postgres://localhost:5432/hylo
DEBUG_GRAPHQL=true
DEBUG_SQL=true
# DEBUG_MEMORY=false
# Enable for crazy amounts of detail (can be helpful for socket debugging)
# DEBUG=*
# DEBUG=oidc-provider:error
# DEBUG=knex:query
# DEBUG=knex:tx
# DEBUG=oidc-provider
DOMAIN=localhost:3000
EMAIL_SENDER=youremail@domain.com
EMAIL_NOTIFICATIONS_ENABLED=true
FACEBOOK_APP_ID=xxxx
FACEBOOK_APP_SECRET=xxx
FACEBOOK_CLIENT_TOKEN=xxxx
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
# See https://the-guild.dev/graphql/yoga-server/docs/features/logging-and-debugging
GRAPHQL_YOGA_LOG_LEVEL=debug
HYLO_TESTER_IDS=
INTERCOM_KEY=
IOS_APP_STORE_URL=https://itunes.apple.com/app/id1002185140
JWT_SECRET=swksjdfkp0fsnfiuniwwib22ji98y086854
LINKEDIN_API_KEY=xxxx
LINKEDIN_API_SECRET=xxxxx
INBOUND_EMAIL_DOMAIN=inbound-staging.hylo.com
INBOUND_EMAIL_SALT=FFFFAAAA123456789
# Public key from the SendGrid webhook security policy on the Inbound Parse setting (verifies email replies)
SENDGRID_INBOUND_PARSE_PUBLIC_KEY=
MAPBOX_TOKEN=xxx
MIXPANEL_TOKEN=
MURMURATIONS_INDEX_API_URL=https://test-index.murmurations.network/v2/nodes
NEW_GROUP_EMAIL=youremail@domain.com
# Stripe Connect: recipient for stripe admin related notifications; new stripe accounts, dispute alarms, etc
PAYMENTS_NOTIFICATION_EMAIL=your-payments-alerts@example.com
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0
# Generate your own: openssl genrsa 2048 | base64 | tr -d '\n'
OIDC_KEYS=
PLAY_APP_SECRET=
PUSH_NOTIFICATIONS_TESTING_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false
PRETTY_JSON=true
PROTOCOL=http
REDIS_URL=redis://localhost:6379
# Server DSN for the shared Sentry project (Settings → Client Keys). Separate from web VITE_SENTRY_DSN.
SENTRY_DSN=
# Optional: production / staging / reviewApp (defaults to NODE_ENV)
SENTRY_ENV=
# See https://sailsjs.com/documentation/concepts/logging for options.
# Currently seems to require silent option to suppress the sql logging
SAILS_LOG_LEVEL=info
SEGMENT_KEY=xxxx
SENDWITHUS_KEY=
SLACK_APP_CLIENT_ID=XXX
SLACK_APP_CLIENT_SECRET=XXX
# Stripe API Keys - Get these from https://dashboard.stripe.com/apikeys
# Use test keys (starting with sk_test_ and pk_test_) for development
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
UPLOADER_PATH_PREFIX=evo-uploads
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Agora
# ---------------------------------------------------------------------------

# Tracking. Hylo's server sends usage events to a service called Segment unless
# this is set. Agora does not track people, so keep it at 1.
DISABLE_SEGMENT=1

# Payments. Agora does not use them, but the server refuses to start without a
# value here. Any text that starts with sk_test_ will do.
# (STRIPE_SECRET_KEY above is the setting; agora/make-env.mjs fills it in.)

# Email. "log" prints every email in the terminal and sends nothing, which is
# what you want on your own computer. "brevo" sends through Brevo and needs
# BREVO_API_KEY. "smtp" sends through a mail server, for example a 7BP mailbox
# at Google Workspace (smtp.gmail.com, an app password) or Infomaniak
# (mail.infomaniak.com). EMAIL_SENDER above is the address the emails come from;
# with smtp it is usually the same mailbox as AGORA_SMTP_USER.
AGORA_EMAIL_TRANSPORT=log
AGORA_EMAIL_SENDER_NAME=Agora
BREVO_API_KEY=
AGORA_SMTP_HOST=
AGORA_SMTP_PORT=587
AGORA_SMTP_USER=
AGORA_SMTP_PASSWORD=

# Meetings. The Jitsi server that hosts the call inside the meeting room.
# kMeet by Infomaniak is built on Jitsi and can be shown inside the room.
# Leave empty to open the event's own video link in a second window instead.
AGORA_MEET_DOMAIN=kmeet.infomaniak.com

# Speech to text. Any service that speaks the OpenAI "audio/transcriptions"
# format works: Infomaniak AI Tools (Whisper, hosted in Switzerland), OpenAI,
# or a Whisper server you run yourself. Without a URL, meetings still work but
# no notes are written.
# For Infomaniak the URL is
#   https://api.infomaniak.com/1/ai/<product id>/openai/audio/transcriptions
# (the product id is the number of your AI Tools product), the key is an
# Infomaniak API token, and the model is "whisper" (used when left empty).
# An Infomaniak URL without a key counts as not connected.
AGORA_TRANSCRIPTION_URL=
AGORA_TRANSCRIPTION_KEY=
AGORA_TRANSCRIPTION_MODEL=
AGORA_TRANSCRIPTION_LANGUAGE=

# The assistant. A key from a Claude developer account. Without it, the minutes
# are the plain transcript with no summary.
ANTHROPIC_API_KEY=
AGORA_AI_MODEL=claude-sonnet-5-5

# Agora admins: the whole admin area (/admin), the Help desk included.
# User ids, or email addresses of accounts whose address is confirmed,
# separated by commas. Ids are the surest. Empty: nobody.
AGORA_ADMINS=

# Help (the button at the bottom right) and the Help desk (/admin/help-desk).
# People who only run the Help desk: they see only the Help desk tab of /admin.
# User ids, or email addresses of accounts whose address is confirmed, separated
# by commas. Ids are the surest.
AGORA_HELPDESK_ADMINS=
# With ANTHROPIC_API_KEY set, people may chat with Claude in the Help window.
# The model for that chat, small and fast by default.
AGORA_HELP_MODEL=claude-haiku-5-5
# Chat messages per person per hour, and new requests per person per day.
AGORA_HELP_CHAT_PER_HOUR=30
AGORA_HELP_REQUESTS_PER_DAY=20
# "off" sends no email when the Help desk answers a request.
AGORA_HELP_REPLY_EMAIL=

# The account the assistant posts from. It is created the first time it is needed.
AGORA_ASSISTANT_NAME=Agora Assistant
AGORA_ASSISTANT_EMAIL=assistant@agora.invalid

# Google Drive. Each circle's Files page (/noo/agora/files/<circle>) shows its
# members the Drive folder an administrator linked to the circle with
# scripts/agora-drive-link.js, and they can add files to it. See "Google Drive"
# in README-AGORA.md.
# The main folder (7BP's shared drive): its id, or its whole Drive link.
AGORA_DRIVE_FOLDER_ID=
# The robot account (service account), Contributor on the shared drive: its key
# file, as base64 (base64 -i key.json). Keep it secret.
AGORA_GOOGLE_SERVICE_ACCOUNT_KEY=
# Fallback only, instead of the robot account: a Google account made only for
# Agora, Contributor on the shared drive and nothing else, never a personal or
# admin account. The "Desktop app" login client of the Google Cloud project,
# then run node agora/google-drive-login.mjs, which fills in the refresh token.
# Keep all three secret.
AGORA_GOOGLE_OAUTH_CLIENT_ID=
AGORA_GOOGLE_OAUTH_CLIENT_SECRET=
AGORA_GOOGLE_OAUTH_REFRESH_TOKEN=
# "on" lets members of a circle add files and folders from Agora. Empty: read only.
AGORA_DRIVE_UPLOADS=
# The largest file a member may add, in MB. Big files go from the browser
# straight to Google, never through Agora's server.
AGORA_DRIVE_MAX_UPLOAD_MB=5120

# Sign-up by invitation only. "on": a new account needs an invitation to a
# circle (the link in an invitation email, or a circle's join link). "off":
# anyone may sign up, as in Hylo. Empty: on for a server (NODE_ENV=production),
# off on your own computer. People who already have an account are not affected.
AGORA_INVITE_ONLY=
# Uploads (profile pictures, banners, attachments, calendar files). Hylo keeps
# them in Amazon S3. Without an S3 bucket AND key (AWS_S3_BUCKET and
# AWS_ACCESS_KEY_ID above), Agora keeps them in this folder on its own disk and
# serves them at /noo/uploads/... Empty: apps/backend/.agora-uploads.
# On the server: /var/lib/agora/uploads (set by agora/vps/server-env.mjs).
AGORA_UPLOADS_DIR=
# Only if the files are served from another address. Empty: PROTOCOL://DOMAIN/noo/uploads
AGORA_UPLOADS_URL=
